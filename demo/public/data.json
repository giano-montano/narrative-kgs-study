{"stories": [{"id": "c152ae65-0ee8-4695-8f5c-ca536f9212cf", "split": "dev", "sentences": ["Kyle traveled to the beach.", "He took his surfboard from the truck.", "He surfed for a couple of minutes until a wave hit him.", "Kyle fell and his foot landed in a rock.", "A life guard had to dive in the water to save him from drowning."]}, {"id": "c7b2536a-a3ee-48c0-af1d-081d76d67872", "split": "dev", "sentences": ["Franny was always cold.", "She bought a big, fluffy blanket to keep her warm.", "She snuggled under it while she watched a movie.", "It was so soft!", "Fran was finally warm and comfortable."]}, {"id": "86983498-bc58-4d37-a2de-9297ee03f03d", "split": "dev", "sentences": ["Carrie's man was cheating on her and she was very mad.", "She took a heavy aluminum bat and bashed in his car's headlights.", "She continued on to the windshield and body.", "As she finished up, the cops arrived.", "Carrie was genuinely surprised when they arrested her."]}, {"id": "862821f2-5f1d-4d9f-b433-371dfcc5e7ed", "split": "dev", "sentences": ["Joana loves buying shoes but not wearing it.", "One day when she counted her shoes it was fifty four pairs.", "When her mother got sick they lack out of money.", "She decided to sell it even it was her collection.", "But when her mother is fine she realized selling her shoes is worth it."]}, {"id": "d995bb60-e6dc-49f2-965e-66f80ab2b94e", "split": "dev", "sentences": ["Terry's grandparent was very sick in the hospital.", "Terry stayed by his side helping him in anyway he could.", "Terry prayed day and night that his grandparent would get better.", "A few days later Terry knew it was time for his grandpa to pass on.", "Holding his hand he watched his Grandpa's eyes close for the last time."]}, {"id": "a6147736-ba50-4aeb-9c0c-007b753b07d5", "split": "test", "sentences": ["The walls are lit up.", "There is a swirl of colors.", "You have to go underground between terminals.", "It is like the twilight zone.", "This is at the Detroit airport."]}, {"id": "a7538344-c611-4d4e-902a-fd2d32beff61", "split": "test", "sentences": ["Steve got a sweater for his birthday.", "Steve didn't like the sweater at all.", "He brought the sweater to a donation center.", "Steve donated the sweater.", "Steve returned to his house."]}, {"id": "5cd50cb5-8f83-4f52-9947-d8a2a8de6870", "split": "test", "sentences": ["Jim and Marcella were adopting a child.", "They stood on the porch impatiently waiting.", "The social worker's car pulled into the driveway.", "A beautiful little five year old boy hopped out of the car.", "Their son had finally arrived."]}, {"id": "1269545a-f9a6-4584-9e36-914e374552c9", "split": "test", "sentences": ["Omar was on vacation.", "And he saw an artisan coffee shop.", "He thought about buying coffee there.", "But he decided it was too expensive.", "When Omar was back at home, though, all he thought about was coffee."]}, {"id": "52dff8fd-68fb-4d21-b67f-3f56e6aee60a", "split": "test", "sentences": ["The hiker found himself lost in the woods.", "He tried to call a friend on his phone.", "His phone would not work.", "He climbed a tree and tried again.", "He reached his friend on the phone."]}, {"id": "e2f53fd9-e3e8-4e8e-bbd5-199712c7d4f0", "split": "test", "sentences": ["Izzy was trying to sleep but it was too hot.", "She rolled back and forth in bed in discomfort.", "She realized she'd never be able to sleep in the heat.", "Instead, she took her blankets outside to the porch.", "There, the cool night air relaxed her and she slept."]}, {"id": "0a6226f5-3035-44a0-935c-771dd2b5adeb", "split": "test", "sentences": ["My wife bought fresh fish last week.", "She picked up a bottle of tartar sauce.", "When she got home she checked and found the sauce had expired.", "She was too tired to go out and get an exchange.", "We made do without the sauce."]}, {"id": "b4728237-e2bc-42c3-880c-abd27ab09283", "split": "test", "sentences": ["Jazmin is driving her blue car home.", "While driving she sees a deer in the road.", "She hits the deer.", "She gets out of her car to check on it.", "The deer is dead and her car is totaled."]}, {"id": "5157b0db-9919-41bb-b192-de9f69b96c71", "split": "test", "sentences": ["Lisa had never tried archery before.", "She was a newbie.", "So she decided to take a whack at it.", "On her first try she scored a bullseye.", "Everyone was impressed."]}, {"id": "d3c80edd-d4ac-4a6d-ab61-7a4b77a49f8a", "split": "test", "sentences": ["Kia had just paid a mechanic to fix her car.", "But the next day, it had problems again!", "She took it back to the mechanic.", "He fixed the mistake again, for free this time.", "Afterwards, the problem was finally resolved."]}, {"id": "9b7315a7-054b-4dbb-833e-5fba1784698d", "split": "test", "sentences": ["Carl was home for the holidays.", "He was looking through his old closet.", "In there he found classic video game systems.", "Carl was excited and took them out.", "He went back home with them."]}, {"id": "996c2aba-6c12-44cb-afef-26c1d3e9f395", "split": "test", "sentences": ["Keith was working at a mechanic shop.", "He had given a customer a high quote.", "Keith kept the difference between the quote and the actual bill.", "Keith's boss found out what he did.", "Keith lost his job."]}, {"id": "602fd2d4-f44c-4896-b35a-b4690eaf69eb", "split": "test", "sentences": ["After class when I was walking to my car I noticed something.", "My window was broken!", "I was very nervous when I approached the car.", "When I got closer I noticed that only one thing was missing.", "Someone had stolen my car radio."]}, {"id": "d48d42a1-b327-433e-af2c-b7949d9cf05a", "split": "test", "sentences": ["A year after my boyfriend was killed, I met another man.", "He was ten years older than me, and from Norway.", "We got along very well.", "We ended up getting married.", "I left him a few years later after he cheated on me."]}, {"id": "46919d93-d90d-49c1-8f95-8fd33aaa5d3a", "split": "test", "sentences": ["Tane overslept and missed his school bus.", "He hoped his mom was still home to drive him to school.", "But she had already left for work, so his stepdad drove him.", "The whole ride to school, Tane had to listen to a long lecture.", "He promised his step dad he would be more responsible in the future."]}, {"id": "2bec0512-87e6-4a9d-b6cf-e558520b7fd2", "split": "test", "sentences": ["We were in town for a conference.", "A bunch of people decided to go to Casino.", "We played some table games.", "A couple people made some good money.", "But we were tired for rest of trip."]}, {"id": "31bc9d81-e5b6-4856-98a7-94360fba0ad5", "split": "test", "sentences": ["Greg had been married for several years.", "He was not satisfied with his life.", "He decided that he was going to look outside of his marriage.", "Greg made a move on his secretary.", "Greg is now cheating on his wife."]}, {"id": "b2def845-c9fb-46b1-9dbc-2facc05f7326", "split": "test", "sentences": ["Larry had a very nice job with good pay.", "He also had no plans to marry or have children.", "He ended up with a sizable amount of money in his bank account.", "He realized that he had no one to leave it to if he died.", "He started going on trips, buying nice things and eating out a lot."]}, {"id": "8c76d4f2-5983-45d4-8d34-6586f8a43e4f", "split": "test", "sentences": ["Hector was being babysat while his mom was out.", "He was having fun with his toys when someone arrived.", "The babysitter had let her boyfriend in.", "Hector knew it was against the rules and told his parents.", "Luckily the girl got into trouble."]}, {"id": "7538c89d-6400-4d11-a73f-f3b5a546848a", "split": "test", "sentences": ["Zach was reading an extremely interesting book as he walked.", "Suddenly the book slipped from his hands and fell to the ground.", "It went into a puddle, completely ruining it.", "Zach was agonizing over not being able to read the ending.", "Luckily he was able to find the story online to finish it."]}, {"id": "91d8facd-306c-47ba-b652-39c7cdcdca30", "split": "test", "sentences": ["New neighbors moved in across the street.", "At first they seemed alright.", "After a while they kept being loud at night.", "I finally decided to talk to them about it.", "They apologized and we moved on."]}, {"id": "9cdbeb1f-e658-4614-abb3-1ee0493a0b93", "split": "test", "sentences": ["Marc was nervous about taking his GRE for graduate school.", "The schools he wanted to attend required high scores.", "He studied flashcards every night for months.", "On the day of the GRE, his nerves subsided.", "When he got his scores, he realized there was nothing to worry about."]}, {"id": "d36a20c8-63f3-4816-a548-d64c64c1519d", "split": "test", "sentences": ["Bobby was going swim at the lake.", "His mother had packed sunscreen for him.", "Bobby's friends didn't use sunscreen.", "He didn't want to be the only one that used the sunscreen.", "Bobby got a sunburn."]}, {"id": "bfc4d031-420d-4efa-b799-ddb7c63ead2f", "split": "test", "sentences": ["Janet made a wish on a shooting star.", "She wished for tickets to her favorite game show.", "Janet wish came true.", "Her grandparents were able to win tickets.", "She attended the game show with her grandparents."]}, {"id": "031f9534-d1c7-49ac-8063-6f3586cc5691", "split": "test", "sentences": ["Frank knew he needed to lose some weight.", "He searched everywhere to find working diet.", "He didn't realize all the time spent searching he wasn't eating.", "He was also up running around the whole time he searched.", "He lost thirty pounds and created his own diet."]}, {"id": "3f5a764b-a6e7-4309-8314-1f20d16e7559", "split": "test", "sentences": ["The boy didn't like crust.", "He complained to his mom.", "His mom cut off the crust.", "The boy appreciated that.", "The boy made his mom a wonderful picture."]}, {"id": "2ea97b5f-657e-4531-9d72-55bc8d441359", "split": "test", "sentences": ["Stephen had a very big table.", "He would use it everyday.", "One day, the table broke a leg.", "Then, Stephen had to rush to the store and get it fixed.", "Now, Stephen is able to eat on his table."]}, {"id": "954e44f6-8559-4324-82f6-671c51781cc9", "split": "test", "sentences": ["On memorial day weekend all of my friends got together.", "We were going to have a barbecue with all kinds of food.", "We took all the food and went down to the pool to enjoy the sunny day.", "We even brought my friends dog down to the pool.", "After we cooked, we fed her dog barbecue chicken."]}, {"id": "62f34c7e-3703-4c7a-8a16-d2eca7326c48", "split": "test", "sentences": ["Bryan had spent all summer sleeping in.", "School was starting in a few days.", "He would have to start getting up at six in the morning.", "He started going to bed earlier and trying to get up in the morning.", "After a few days Brian was back in the routine of getting up early."]}, {"id": "35e60606-0195-4d75-8352-2b3e7db3d124", "split": "test", "sentences": ["Julia loved cooking.", "She was hired by a local restaurant.", "She worked very hard to create a great menu.", "All of the people in town loved the food.", "She became well known as a cook."]}], "gold": {"c152ae65-0ee8-4695-8f5c-ca536f9212cf": [["traveled", "agent", "Kyle", "Character"], ["traveled", "location", "beach", "Location"], ["traveled", "next", "took", "Event"], ["took", "agent", "Kyle", "Character"], ["took", "patient", "surfboard", "Object"], ["took", "location", "truck", "Location"], ["took", "next", "surfed", "Event"], ["surfed", "agent", "Kyle", "Character"], ["surfed", "next", "hit", "Event"], ["hit", "agent", "wave", "Object"], ["hit", "patient", "Kyle", "Character"], ["hit", "next", "fell", "Event"], ["fell", "agent", "Kyle", "Character"], ["fell", "next", "landed", "Event"], ["landed", "agent", "foot", "Object"], ["landed", "location", "rock", "Location"], ["landed", "next", "dive", "Event"], ["dive", "agent", "guard", "Character"], ["dive", "location", "water", "Location"], ["dive", "next", "save", "Event"], ["save", "agent", "guard", "Character"], ["save", "patient", "Kyle", "Character"]], "c7b2536a-a3ee-48c0-af1d