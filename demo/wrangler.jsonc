{
  "name": "narrative-kg-demo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // freno por IP para no agotar la cuota gratuita de Groq
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
